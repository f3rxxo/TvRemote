<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="RoundButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:backgroundTint">@color/card</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:minWidth">76dp</item>
    </style>

    <style name="DpadButton">
        <item name="android:layout_width">130dp</item>
        <item name="android:layout_height">130dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:backgroundTint">@color/card</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="SmallButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:backgroundTint">@color/card</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingLeft">10dp</item>
        <item name="android:paddingRight">10dp</item>
    </style>
</resources>
